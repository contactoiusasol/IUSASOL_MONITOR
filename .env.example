# Ejemplo de configuración .env.local
# Reemplaza estos valores con tus credenciales de Supabase

# URL de tu proyecto Supabase
VITE_SUPABASE_URL=https://your-project-name.supabase.co

# Clave anónima de tu proyecto
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Token de la API IUSASOL - SOLO para desarrollo (npm run dev).
# En produccion el token NO viaja en JavaScript: lo usa public/api/proxy.php.
# Copia aqui el mismo valor de public/api/token.config.php
VITE_IUSASOL_TOKEN=PEGA_AQUI_TU_TOKEN_DE_IUSASOL
